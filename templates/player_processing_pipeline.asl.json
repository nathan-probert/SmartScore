{
    "Comment": "A state machine to handle all player processing, predictions, and publishing. CheckCompleted returns only the run status: the published roster is over the Step Functions 256KB state limit. normal_run and last_run reload the day's lean players/teams slices (Working-* tables) via LoadWorkingSet so the state always carries separated slices, never denormalized rows. On first_run the lineup/goalie/injury steps run before MakePredictions and SaveToDb; normal_run also archives (SaveToDb) so the mid-morning projections refresh Player-Snapshots, but skips UpdateHistory. last_run skips that chain entirely (every game has started, so the picks API is locked and the Tims read can only fail) and goes straight to PublishToDb, whose tims=0 write flips the frontend to its 'All games have started' state; save_to_db carries the prior opp_goalie_* values forward, and CheckSaveHistory's Default sends it to PublishToDb without UpdateHistory.",
    "StartAt": "GetDate",
    "States": {
        "GetDate": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:CheckCompleted-${ENV}",
            "Next": "CheckCompletion"
        },
        "CheckCompletion": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.status",
                    "StringEquals": "normal_run",
                    "Next": "LoadWorkingSet"
                },
                {
                    "Variable": "$.status",
                    "StringEquals": "first_run",
                    "Next": "Backfill"
                },
                {
                    "Variable": "$.status",
                    "StringEquals": "last_run",
                    "Next": "LoadWorkingSet"
                }
            ]
        },
        "LoadWorkingSet": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:LoadWorkingSet-${ENV}",
            "Next": "CheckLastRun"
        },
        "CheckLastRun": {
            "Type": "Choice",
            "Comment": "last_run exits before the enrichment chain: every game has started, so the picks API is locked and a GetTims read can only fail (the 30s Lambda timeout hits before its locked-picks fallback can run). PublishToDb clears the tims groups itself.",
            "Choices": [
                {
                    "Variable": "$.status",
                    "StringEquals": "last_run",
                    "Next": "PublishToDb"
                }
            ],
            "Default": "GetInjuries"
        },
        "Backfill": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:PerformBackfilling-${ENV}",
            "Next": "GetPlayersStateMachine"
        },
        "GetPlayersStateMachine": {
            "Type": "Task",
            "Resource": "arn:aws:states:::states:startExecution.sync",
            "Parameters": {
                "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:GetPlayers-${ENV}",
                "Input": {
                    "input.$": "$"
                }
            },
            "ResultSelector": {
                "parsed.$": "States.StringToJson($.Output)"
            },
            "ResultPath": "$",
            "OutputPath": "$.parsed",
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.TaskFailed"
                    ],
                    "IntervalSeconds": 60,
                    "MaxAttempts": 3,
                    "BackoffRate": 5.0
                }
            ],
            "Next": "EnsureFirstRunStatus"
        },
        "EnsureFirstRunStatus": {
            "Type": "Pass",
            "Comment": "The GetPlayers sub-machine returns only players/teams. This branch is first_run by construction, so restore the status CheckSaveHistory need.",
            "Parameters": {
                "players.$": "$.players",
                "teams.$": "$.teams",
                "status": "first_run"
            },
            "Next": "CheckIfPlayersOutputIsEmpty"
        },
        "CheckIfPlayersOutputIsEmpty": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.players[0]",
                    "IsPresent": false,
                    "Next": "UpdateHistory"
                }
            ],
            "Default": "GetInjuries"
        },
        "GetInjuries": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:GetInjuries-${ENV}",
            "Next": "GetGoalies"
        },
        "GetGoalies": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:GetGoalies-${ENV}",
            "Next": "GetLineups"
        },
        "GetLineups": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:GetLineups-${ENV}",
            "Next": "MakePredictions"
        },
        "MakePredictions": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:MakePredictions-${ENV}",
            "Next": "GetTims"
        },
        "GetTims": {
            "Type": "Task",
            "Comment": "First/normal runs archive AND publish via SaveToDb (PR #134 made normal_run archive too, and PR #136 made last_run exit at CheckLastRun), so the former CheckInitialRun Choice state had all three branches going to the same SaveToDb and was removed. CheckSaveHistory still branches on $.status.",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:GetTims-${ENV}",
            "Next": "SaveToDb"
        },
        "SaveToDb": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:SavePlayers-${ENV}",
            "Next": "CheckSaveHistory"
        },
        "CheckSaveHistory": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.status",
                    "StringEquals": "first_run",
                    "Next": "UpdateHistory"
                }
            ],
            "Default": "PublishToDb"
        },
        "UpdateHistory": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:UpdateHistory-${ENV}",
            "Next": "PublishToDb"
        },
        "PublishToDb": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:PublishDb-${ENV}",
            "End": true
        }
    }
}
