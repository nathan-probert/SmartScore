{
    "Comment": "A state machine to handle all player processing, predictions, and publishing. CheckCompleted returns only the run status: the published roster is over the Step Functions 256KB state limit. normal_run and last_run reload the day's lean players/teams slices (Working-* tables) via LoadWorkingSet so the state always carries separated slices, never denormalized rows. normal_run re-enters the enrichment chain at GetInjuries; last_run skips that chain entirely (every game has started, so the picks API is locked and the Tims read can only fail) and goes straight to PublishToDb, which clears the tims groups (all 0) so the frontend flips to its 'All games have started' state.",
    "StartAt": "GetDate",
    "States": {
        "GetDate": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:CheckCompleted-${ENV}",
            "Next": "CheckCompletion"
        },
        "CheckCompletion": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.status",
                    "StringEquals": "normal_run",
                    "Next": "LoadWorkingSet"
                },
                {
                    "Variable": "$.status",
                    "StringEquals": "first_run",
                    "Next": "Backfill"
                },
                {
                    "Variable": "$.status",
                    "StringEquals": "last_run",
                    "Next": "LoadWorkingSet"
                }
            ]
        },
        "LoadWorkingSet": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:LoadWorkingSet-${ENV}",
            "Next": "CheckLastRun"
        },
        "CheckLastRun": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.status",
                    "StringEquals": "last_run",
                    "Next": "PublishToDb"
                }
            ],
            "Default": "GetInjuries"
        },
        "Backfill": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:PerformBackfilling-${ENV}",
            "Next": "GetPlayersStateMachine"
        },
        "GetPlayersStateMachine": {
            "Type": "Task",
            "Resource": "arn:aws:states:::states:startExecution.sync",
            "Parameters": {
                "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:GetPlayers-${ENV}",
                "Input": {
                    "input.$": "$"
                }
            },
            "ResultSelector": {
                "parsed.$": "States.StringToJson($.Output)"
            },
            "ResultPath": "$",
            "OutputPath": "$.parsed",
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.TaskFailed"
                    ],
                    "IntervalSeconds": 60,
                    "MaxAttempts": 3,
                    "BackoffRate": 5.0
                }
            ],
            "Next": "CheckIfPlayersOutputIsEmpty"
        },
        "CheckIfPlayersOutputIsEmpty": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.players[0]",
                    "IsPresent": false,
                    "Next": "UpdateHistory"
                }
            ],
            "Default": "MakePredictions"
        },
        "MakePredictions": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:MakePredictions-${ENV}",
            "Next": "GetInjuries"
        },
        "GetInjuries": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:GetInjuries-${ENV}",
            "Next": "GetGoalies"
        },
        "GetGoalies": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:GetGoalies-${ENV}",
            "Next": "GetLineups"
        },
        "GetLineups": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:GetLineups-${ENV}",
            "Next": "GetTims"
        },
        "GetTims": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:GetTims-${ENV}",
            "Next": "CheckInitialRun"
        },
        "CheckInitialRun": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.status",
                    "StringEquals": "first_run",
                    "Next": "SaveToDb"
                },
                {
                    "Variable": "$.status",
                    "StringEquals": "normal_run",
                    "Next": "PublishToDb"
                }
            ],
            "Default": "PublishToDb"
        },
        "SaveToDb": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:SavePlayers-${ENV}",
            "Next": "UpdateHistory"
        },
        "UpdateHistory": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:UpdateHistory-${ENV}",
            "Next": "PublishToDb"
        },
        "PublishToDb": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:PublishDb-${ENV}",
            "End": true
        }
    }
}
