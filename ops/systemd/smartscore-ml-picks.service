# SmartScore ML picks, run locally instead of GitHub Actions.
#
# Copy these two files into /etc/systemd/system (or ~/.config/systemd/user/
# for a user-level unit) and `systemctl daemon-reload`. The timer replaces
# BOTH triggers the ml-picks.yml workflow used: the nightly cron and the
# per-game MLPickKick repository_dispatches - run_daily_picks is already
# built for re-firing (it exits 0 cleanly when the live snapshot has no rows
# for the date, patches ONLY the stat column, and the backfill's per-date
# marker rows make same-day re-runs no-ops), so a fixed 30-minute cadence
# covers the game-day refresh cadence the kicks used to provide.

[Unit]
Description=SmartScore ML picks pass (local backtrack SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/SmartScore
# .env must carry at least: ENV, SUPABASE_URL, SUPABASE_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY. The ML_HISTORY_* lines below route the
# backtrack family to data/ml_history.sqlite and mirror every write to
# Supabase during the parity window (docs/ml-picks-local-runbook.md).
EnvironmentFile=%h/code/SmartScore/.env
Environment=ML_HISTORY_BACKEND=sqlite
Environment=ML_HISTORY_DUAL_WRITE=1
ExecStart=%h/.local/bin/uv run python smartscore/scripts/backtrack/run_daily_picks.py --env prod
TimeoutStartSec=3600
