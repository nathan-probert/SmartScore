# Backtrack raw store and background-task state.
#
# data/raw_nhl.sqlite is the working copy, rebuilt from the committed dumps - see
# `make backtrack-load`. Committing it as well would duplicate every row. Git
# compresses it to ~4 MB so it is not fatal either way, but there is no reason to
# carry two copies of the same data that can drift.
data/raw_nhl.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm

# PID files and logs from run_background.py - machine state, not source.
data/bg/

# HTTP payload cache at the repo root. Re-fetchable by a crawl and redundant
# with data/dumps/, which is the versioned source of truth. Lives outside the
# smartscore subtree so a deploy-time copy can never stage it into the Lambda
# zip (see nhl_client.CACHE_DIR).
data/cache/

# Scratch output from ad-hoc foreground runs. The tracked runner writes its own
# logs to data/bg/ instead, which is already ignored above.
data/*.log
data/*.err

# HTTP crawl cache - large, rebuilt from any crawl; never shipped anywhere.
data/cache/

# Model training caches, re-fetched from Supabase (see model.py).
data/ml/

# V16 experiment run residue (deleted in chore/clean-tree; the record lives
# in MODEL_NOTES.md + git history). Never re-track the pick dumps or per-fold
# scraps if they are regenerated.
smartscore/scripts/backtrack/exp_v16_pick*.pkl
smartscore/scripts/backtrack/exp_v16_perfold*.csv

# Mis-named MoneyPuck-derived own-xG cache: no code reads it (V7-shots and
# V8-own-xG were both rejected) and it is raw re-fetchable data.
data/moneypuck/
